# Bitcoin Network Configuration
# Options: testnet, signet, regtest, mainnet
BITCOIN_NETWORK=signet

# Blockstream / Mempool Esplora API URL
ESPLORA_API_URL=https://mempool.space/signet/api

# Public Signet Faucet URLs
SIGNET_FAUCET_URL=https://bitcoinsignetfaucet.com
SIGNET_FAUCET_ALT_URL=https://signetfaucet.com


# Target Fallback Fee Rate (sat/vB)
DEFAULT_FEE_RATE_SAT_VB=2

# Node Private Keys (WIF format for Testnet/Signet)
ALICE_PRIVATE_KEY=
BOB_PRIVATE_KEY=
DAVE_PRIVATE_KEY=

# Node Public Keys (Compressed Hex)
ALICE_PUBKEY=
BOB_PUBKEY=
DAVE_PUBKEY=

# Node Native SegWit Addresses (P2WPKH Bech32)
ALICE_ADDRESS=
BOB_ADDRESS=
DAVE_ADDRESS=
